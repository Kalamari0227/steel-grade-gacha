{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "placement-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "placementSha256",
    "characterSha256",
    "itemSha256",
    "protectedIntersectionRatio",
    "visible",
    "fullCard",
    "at72"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "const": "approved"
    },
    "placementSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "characterSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "itemSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protectedIntersectionRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.01
    },
    "visible": {
      "const": true
    },
    "fullCard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "at72": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)[A-Za-z0-9_./-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
